# Dependencies are restored with `npm install`, so they must never be committed
node_modules/

# Build outputs (regenerated by `npm run build`)
dist/
*.ait

# SDK 2.x toolchain cache (created by `granite dev` / `ait build`)
.granite/

# Local environment secrets
.env
.env.local
.env.*.local

# Local Supabase CLI project-link state
supabase/.temp/

# Editor/OS noise
.DS_Store

.idea/
.omx/
*.log
